#   call system('tmux setenv "NVIM_PIPE_$TMUX_PANE" ' . v:servername)
#
#   augroup autocom
#     autocmd VimLeave * call system('tmux setenv -u "NVIM_PIPE_$TMUX_PANE"')
#   augroup END
# endif

tmux_pane_id=$(
  tmux list-panes -F '#{pane_id}:#{pane_current_command}' \
  | sed -nE 's/:n?vim$//p' \
  | sort -g -k2 -t% \
  | head -1
)
# nvim_pipe="$HOME/.cache/nvim-sockets/tmux-pane-$tmux_pane_id"
nvim_pipe=$(tmux showenv "NVIM_PIPE_$tmux_pane_id" | cut -d= -f2-)
if [ -z "$nvim_pipe" ]; then
  nvim_pipe="$HOME/.cache/nvim-sockets/tmux-pane-$tmux_pane_id"
  # echo "Error: No nvim instance found in the current tmux pane." >&2
  # exit 1
fi

# tmux list-panes -F '#{pane_id}:#{pane_current_command}:#{pane_pid}:#{pane_tty}'
# nvim_tty=$(
#   tmux list-panes -F '#{pane_tty}:#{pane_current_command}' \
#   | sed -nE 's/^\/dev\/(.*):n?vim$/\1/p' \
#   | sort -g -k2 -t% \
#   | head -1
# )
# nvim_pid=$(pgrep -t "$nvim_tty" vim)
# nvim_pipe=$(lsof -U -a -p "$nvim_pid" 2>/dev/null | grep -o '/[^ ]*nvim[^ ]*')

clean() {
  if [ -n "$temp_file" ] && [ -f "$temp_file" ]; then
    rm -f "$temp_file"
  fi
}

trap clean EXIT

send_command() {
  nvim --server "$nvim_pipe" --remote-send "$1<CR>"
}

open_file() {
  filename=$(echo "$1" | sed -nE 's/^(.+):[0-9]+/\1/p')
  line_number=$(echo "$1" | sed -nE 's/^.+:([0-9]+)/\1/p')
  if [ -z "$filename" ]; then
    filename="$1"
  fi
  nvim --server "$nvim_pipe" --remote "$(realpath "$filename")"
  if [ -n "$line_number" ]; then
    send_command ":$line_number"
    send_command ":normal zz"
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    cf)
      temp_file=$(mktemp /tmp/v.XXXXXXXXXX)
      cat > "$temp_file"
      send_command ":cgetfile $temp_file"
      send_command ":copen"
      ;;
    +*)
      send_command "$(echo "${1}" | sed -E 's/^\+/:/')"
      ;;
    *)
      open_file "$1"
      ;;
  esac
  shift
done

tmux select-pane "-t$tmux_pane_id"
