#! /bin/sh -e

# Add this to init.vim:
#
# if (!empty($TMUX_PANE)) && (!empty($NVIM_LISTEN_ADDRESS))
#   call system("mkdir -p $HOME/.cache/nvim-sockets")
#   call system("ln -fs $NVIM_LISTEN_ADDRESS $HOME/.cache/nvim-sockets/tmux-pane-$TMUX_PANE")
#
#   augroup autocom
#     autocmd VimLeave * call system("rm $HOME/.cache/nvim-sockets/tmux-pane-$TMUX_PANE")
#   augroup END
# endif

tmux_pane_id=$(
  tmux list-panes -F '#{pane_id}:#{pane_current_command}' \
  | sed -nE 's/:n?vim$//p' \
  | sort -g -k2 -t% \
  | head -1
)

nvim_pipe="$HOME/.cache/nvim-sockets/tmux-pane-$tmux_pane_id"

clean() {
  if [ -n "$temp_file" ] && [ -f "$temp_file" ]; then
    rm -f "$temp_file"
  fi
}

trap clean EXIT

send_command() {
  nvim --server "$nvim_pipe" --remote-send "$1<CR>"
}

open_file() {
  filename=$(echo "$1" | sed -nE 's/^(.+):[0-9]+/\1/p')
  line_number=$(echo "$1" | sed -nE 's/^.+:([0-9]+)/\1/p')
  if [ -z "$filename" ]; then
    filename="$1"
  fi
  nvim --server "$nvim_pipe" --remote "$(realpath "$filename")"
  if [ -n "$line_number" ]; then
    send_command ":$line_number"
    send_command ":normal zz"
  fi
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    cf)
      temp_file=$(mktemp /tmp/v.XXXXXXXXXX)
      cat > "$temp_file"
      send_command ":cgetfile $temp_file"
      send_command ":copen"
      ;;
    +*)
      send_command "$(echo "${1}" | sed -E 's/^\+/:/')"
      ;;
    *)
      open_file "$1"
      ;;
  esac
  shift
done

tmux select-pane "-t$tmux_pane_id"
